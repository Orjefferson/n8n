# Chave da Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Token do bot criado com o @BotFather
TELEGRAM_BOT_TOKEN=

# ID numérico do chat (ou @canal) que recebe o rascunho para aprovação
TELEGRAM_CHAT_ID=

# Porta publicada no host. O contentor continua a escutar em 5678.
N8N_PORT=5678

# URL pública HTTPS do túnel (Cloudflare/ngrok). Sem path final além da barra.
# Ex.: https://abc123.trycloudflare.com/
# Local sem HITL: http://localhost:5678/
WEBHOOK_URL=http://localhost:5678/

# Host/protocolo alinhados ao WEBHOOK_URL (https + hostname do túnel em produção local)
N8N_PROTOCOL=http
N8N_HOST=localhost

# Sidecar de carrossel/drafts (rede Docker interna)
CAROUSEL_URL=http://carousel:3000

# LinkedIn — app em https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# urn:li:person:XXXX obtido após OAuth
LINKEDIN_AUTHOR_URN=
# Access token OAuth com escopo w_member_social (renovar quando expirar)
LINKEDIN_ACCESS_TOKEN=
