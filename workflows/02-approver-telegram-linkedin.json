    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "={{ $env.GEMINI_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  systemInstruction: { parts: [{ text: \"És um ghostwriter de LinkedIn para Product Managers e Tech Leads no Brasil. Recebes um rascunho JSON e instruções de ajuste do autor. Aplica os ajustes sem inventar factos. Mantém PT-BR, tom direto, sem markdown. Se necessário, regenera o carrossel (5–8 slides) coerente com o novo texto. Responde SOMENTE com JSON no mesmo schema do rascunho.\" }] },\n  contents: [{ role: 'user', parts: [{ text: $json.prompt }] }],\n  generationConfig: {\n    temperature: 0.4,\n    maxOutputTokens: 8192,\n    responseMimeType: 'application/json'\n  }\n}) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "a02-rev-gemini",
      "name": "Gemini revisão",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2220,
        620
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const response = $input.first().json;\nconst prev = $('Montar prompt revisão').first().json;\n\nif (response?.promptFeedback?.blockReason) {\n  throw new Error('Pedido bloqueado pelo Gemini: ' + response.promptFeedback.blockReason);\n}\n\nconst parts = response?.candidates?.[0]?.content?.parts ?? [];\nconst text = parts.map((part) => part.text || '').join('').trim();\nif (!text) throw new Error('Resposta vazia do Gemini na revisão.');\n\nlet parsed;\ntry {\n  const fence = String.fromCharCode(96, 96, 96);\n  const cleaned = text\n    .replace(new RegExp('^' + fence + 'json\\\\\\\\s*', 'i'), '')\n    .replace(new RegExp('^' + fence + '\\\\\\\\s*', 'i'), '')\n    .replace(new RegExp('\\\\\\\\s*' + fence + '$', 'i'), '')\n    .trim();\n  parsed = JSON.parse(cleaned);\n} catch (error) {\n  throw new Error('JSON de revisão inválido: ' + error.message);\n}\n\nconst slides = Array.isArray(parsed.carousel_slides) ? parsed.carousel_slides.slice(0, 8) : [];\nconst hashtags = Array.isArray(parsed.hashtags) ? parsed.hashtags : [];\nlet postText = String(parsed.post_text || '').trim();\nif (!postText || slides.length < 3) throw new Error('Revisão incompleta.');\n\nif (hashtags.length && !hashtags.some((tag) => postText.includes(tag))) {\n  postText = postText + '\\n\\n' + hashtags.join(' ');\n}\n\nconst draftId = prev.draftId;\nconst revisionCount = Number(prev.revisionCount || 0) + 1;\n\nreturn [{\n  json: {\n    draftId,\n    status: 'pending',\n    revisionCount,\n    pendingRevision: false,\n    hook: parsed.hook || '',\n    post_text: postText,\n    hashtags,\n    carousel_slides: slides,\n    sources: Array.isArray(parsed.sources) ? parsed.sources : prev.draft.sources,\n    links: prev.draft.links || [],\n    count: prev.draft.count || 0,\n  },\n}];\n"
      },
