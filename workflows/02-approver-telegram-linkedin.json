      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const body = $input.first().json;\nconst expectedChat = String($env.TELEGRAM_CHAT_ID || '');\nconst staticData = $getWorkflowStaticData('global');\n\nconst cq = body.callback_query;\nif (cq) {\n  const chatId = String(cq.message?.chat?.id ?? '');\n  const data = String(cq.data || '');\n  const [action, draftId] = data.split(':');\n  return [{\n    json: {\n      kind: 'callback',\n      okChat: chatId === expectedChat,\n      chatId,\n      action: action || '',\n      draftId: draftId || '',\n      callbackQueryId: cq.id,\n      messageId: cq.message?.message_id,\n      text: '',\n    },\n  }];\n}\n\nconst msg = body.message;\nif (msg && msg.text && !msg.text.startsWith('/')) {\n  const chatId = String(msg.chat?.id ?? '');\n  const draftId = staticData.pendingRevisionDraftId || '';\n  return [{\n    json: {\n      kind: 'revision_text',\n      okChat: chatId === expectedChat,\n      chatId,\n      action: 'apply_revision',\n      draftId,\n      callbackQueryId: '',\n      messageId: msg.message_id,\n      text: msg.text,\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    kind: 'ignore',\n    okChat: false,\n    chatId: '',\n    action: '',\n    draftId: '',\n    callbackQueryId: '',\n    messageId: null,\n    text: '',\n  },\n}];\n"
      },
